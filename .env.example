# ============================================================
# noomit-backend 로컬 개발용 환경 설정 예제
# 사용법: 이 파일을 프로젝트 루트에 .env 로 복사한 뒤 값 확인
#   cp .env.example .env
#   docker compose -f docker-compose.local.yml up -d
# ============================================================

SERVER_PORT=8080
SPRING_APPLICATION_NAME=noomit-backend

# DB 접속 정보는 없어도 된다 — local 프로필이 기본값이라 application-local.yaml 이 자동 적용된다.

# --- Flyway (스키마는 마이그레이션으로만 관리 — ddl-auto 켜지 말 것) ---
SPRING_FLYWAY_ENABLED=true

# --- CORS / CSRF ---
NOOMIT_CORS_ALLOWED_ORIGINS=http://localhost:3000
# 운영에서는 true로 설정한다 (HTTPS 전제).
NOOMIT_CSRF_SECURE_COOKIE=false
