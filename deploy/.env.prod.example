# ============================================================
# noomit 프로덕션 환경 설정 예제
# 사용법: 인스턴스의 deploy/ 디렉터리에서 이 파일을 .env.prod 로 복사한 뒤 값 채우기
#   cp .env.prod.example .env.prod
# .env.prod 는 절대 커밋하지 않는다 (.gitignore 로 막혀 있음).
# ============================================================

SERVER_PORT=8080
SPRING_APPLICATION_NAME=noomit-backend

# --- DB (db 서비스 컨테이너 이름이 곧 호스트명) ---
DB_USERNAME=noomit
DB_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://db:5432/noomit
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# --- Flyway ---
SPRING_FLYWAY_ENABLED=true

# --- CORS / CSRF ---
NOOMIT_CORS_ALLOWED_ORIGINS=https://noomit.abcganada.xyz
NOOMIT_CSRF_SECURE_COOKIE=true

# --- 프론트엔드 빌드용 ---
# NEXT_PUBLIC_* 는 런타임이 아니라 빌드 시점에 결과물에 박힌다(frontend/Dockerfile 참고).
# 여기 값은 docker compose 실행이 아니라 CI에서 이미지를 빌드할 때 build arg 로 넘겨야 의미가 있다.
NEXT_PUBLIC_API_URL=https://noomit.abcganada.xyz
