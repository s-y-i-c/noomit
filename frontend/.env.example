# ============================================================
# noomit-frontend 로컬 개발용 환경 설정 예제
# 사용법: 이 파일을 프로젝트 루트에 .env.development.local 로 복사한 뒤 값 확인
#   cp .env.example .env.development.local
# ============================================================

# 백엔드 API 주소. 브라우저에 노출되고 빌드 결과에 그대로 박히므로
# 비밀번호, 토큰, 인증서 경로와 Secret은 여기 넣지 않는다.
NEXT_PUBLIC_API_URL=http://localhost:8080
